# HeatAI 评估模块环境变量模板
# 复制此文件为 .env 并修改配置

DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_EVAL_MODEL=qwen3-max
DASHSCOPE_EVAL_MODEL_LITE=qwen-plus

EVAL_MAX_QUESTIONS=0
EVAL_OUTPUT_DIR=./eval_output
EVAL_BATCH_SIZE=10

EVAL_JUDGE_TEMPERATURE=0.0

EVAL_RETRIEVAL_TOP_K=10
EVAL_FINAL_TOP_K=8

EVAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EVAL_EMBEDDING_DEVICE=cpu
EVAL_EMBEDDING_DIM=1024

REPORT_INCLUDE_LATEX=false
