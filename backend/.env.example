# HeatAI 环境变量配置模板
# 复制此文件为 .env 并修改配置

SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (默认)
DATABASE_URL=postgresql+asyncpg://heatai:your_password@localhost:5432/heatai
DATABASE_URL_SYNC=postgresql+psycopg2://heatai:your_password@localhost:5432/heatai

# SQLite (开发备选，取消注释并注释上面两行)
# DATABASE_URL=sqlite+aiosqlite:///./heatai.db
# DATABASE_URL_SYNC=sqlite+pysqlite:///./heatai.db

# Redis (可选)
REDIS_URL=redis://localhost:6379/0

# 阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# CORS 允许的源
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 长期记忆配置
# MEMORY_LLM_MODEL=qwen-turbo                  # 记忆提取/压缩使用的 LLM（推荐轻量模型）
# MEMORY_EXTRACT_TRIGGER_ROUNDS=5               # 每多少轮对话触发一次 LLM 记忆提取
# MEMORY_COMPRESS_THRESHOLD_CHARS=5000          # 记忆总长度超过此阈值自动触发 LLM 压缩
# MEMORY_MAX_CONTEXT_CHARS=3000                 # 注入 LLM 上下文的最大记忆长度
# MEMORY_DECAY_HALF_LIFE_DAYS=30               # 记忆衰减半衰期（天），超过后权重降为50%
# MEMORY_EMOTION_MAX_ENTRIES=20                 # 情绪时间线最大保留条数
# MEMORY_SESSION_SNAPSHOT_MAX=10                # 跨会话快照最大保留数
